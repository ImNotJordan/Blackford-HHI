# Staff CRM — copy to apps/staff/.env.local
# Demo (default): no cloud credentials required.

APP_ENV=demo
NODE_ENV=development
STAFF_APP_URL=http://localhost:3000
PORTAL_APP_URL=http://localhost:3001

QUIET_HOURS_START=21:00
QUIET_HOURS_END=08:00

