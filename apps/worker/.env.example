# Automation worker — copy to apps/worker/.env
# Jobs stay stubs until Graphile Worker is wired; env still validates.

APP_ENV=demo
NODE_ENV=development
STAFF_APP_URL=http://localhost:3000
PORTAL_APP_URL=http://localhost:3001

QUIET_HOURS_START=21:00
QUIET_HOURS_END=08:00

