# =============================================================================
# Blackford Platform — environment template (root reference)
# =============================================================================
# Copy the relevant vars into:
#   apps/staff/.env.local
#   apps/worker/.env
#
# APP_ENV=demo  → UI-only; cloud vars optional (default for local)
# APP_ENV=development → local with optional real services
# APP_ENV=staging|production → DATABASE_URL, Identity, AWS messaging required
#
# Sign BAAs before client data leaves the apps (Scope of Work dates):
#   Google Cloud BAA: https://cloud.google.com/terms/hipaa-baa
#   Google HIPAA covered products: https://docs.cloud.google.com/docs/security/compliance/hipaa
#   AWS HIPAA eligible services: https://aws.amazon.com/compliance/hipaa-eligible-services-reference/
#   Accept AWS BAA in Artifact: https://docs.aws.amazon.com/artifact/latest/ug/manage-agreements.html
# =============================================================================

APP_ENV=demo
NODE_ENV=development

# Public app URLs (links in emails/texts, CORS, redirects)
STAFF_APP_URL=http://localhost:3200
PORTAL_APP_URL=http://localhost:3300

# -----------------------------------------------------------------------------
# Database — Cloud SQL PostgreSQL (Drizzle)
# Required when APP_ENV=staging|production
# Setup: https://cloud.google.com/sql/docs/postgres/create-instance
# Connect from local / Cloud Run: https://cloud.google.com/sql/docs/postgres/connect-overview
# Console: https://console.cloud.google.com/sql
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://blackford:PASSWORD@127.0.0.1:5432/blackford

# -----------------------------------------------------------------------------
# Sign-in — Google Cloud Identity Platform
# Staff: password + authenticator · Employer: one-time code
# NEXT_PUBLIC_* is exposed to the browser (publishable only)
# Setup: https://cloud.google.com/identity-platform/docs/quickstart-email-password
# Console: https://console.cloud.google.com/customer-identity
# vs Firebase Auth: https://docs.cloud.google.com/identity-platform/docs/product-comparison
# HIPAA guide: https://cloud.google.com/security/compliance/hipaa/identity-platform
# Phone OTP: https://cloud.google.com/identity-platform/docs/phone
# MFA: https://cloud.google.com/identity-platform/docs/admin/manage-mfa-users
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_IDENTITY_API_KEY=
# NEXT_PUBLIC_IDENTITY_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
# NEXT_PUBLIC_IDENTITY_PROJECT_ID=YOUR_PROJECT
# IDENTITY_PLATFORM_PROJECT_ID=YOUR_PROJECT

# -----------------------------------------------------------------------------
# Files & encryption — Cloud Storage + Cloud KMS
# Storage setup: https://cloud.google.com/storage/docs/creating-buckets
# Console: https://console.cloud.google.com/storage
# Block public access: https://cloud.google.com/storage/docs/using-public-access-prevention
# KMS setup: https://cloud.google.com/kms/docs/create-key
# Console: https://console.cloud.google.com/security/kms
# -----------------------------------------------------------------------------
# GOOGLE_CLOUD_PROJECT=YOUR_PROJECT
# GCS_BUCKET_DOCUMENTS=blackford-documents-dev
# GCS_BUCKET_CENSUS=blackford-census-dev
# KMS_KEY_NAME=projects/YOUR_PROJECT/locations/global/keyRings/blackford/cryptoKeys/ssn

# -----------------------------------------------------------------------------
# Email & text — AWS SES + End User Messaging (BAA required before client data)
# SES setup: https://docs.aws.amazon.com/ses/latest/dg/setting-up.html
# Console: https://console.aws.amazon.com/ses/home
# End User Messaging (SMS): https://docs.aws.amazon.com/sms-voice/latest/userguide/what-is-service.html
# SMS compliance: https://docs.aws.amazon.com/sms-voice/latest/userguide/compliance-validation.html
# A2P 10DLC registration: https://docs.aws.amazon.com/sms-voice/latest/userguide/registrations-10dlc.html
# IAM access keys: https://docs.aws.amazon.com/IAM/latest/UserGuide/id_credentials_access-keys.html
# -----------------------------------------------------------------------------
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_FROM_ADDRESS=noreply@example.com
# SMS_ORIGINATION_IDENTITY=  # phone number or sender ID after 10DLC registration

# -----------------------------------------------------------------------------
# Automations / bulk send quiet hours (local time HH:mm)
# -----------------------------------------------------------------------------
QUIET_HOURS_START=21:00
QUIET_HOURS_END=08:00
